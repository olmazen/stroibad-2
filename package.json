{
  "name": "egoe-public-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reproducible public build and quality gates for the EGOE static site",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/sync-site-shell.mjs --check && node tools/sync-product-data.mjs --check && node tools/sync-runtime-assets.mjs --check && node tools/build-public-site.mjs",
    "sync:shell": "node tools/sync-site-shell.mjs --write",
    "sync:data": "node tools/sync-product-data.mjs --write",
    "sync:runtime-assets": "node tools/sync-runtime-assets.mjs --write",
    "sync:external-assets": "node tools/localize-external-assets.mjs --write",
    "test:shell": "node --test tools/site-shell.test.mjs",
    "test:data": "node --test tools/product-data.test.mjs",
    "test:runtime": "node --test tools/runtime-resilience.test.mjs",
    "test:leads": "node --test tools/lead-delivery.test.mjs",
    "test:backend": "node --test tools/lead-backend.test.mjs",
    "test:email": "node --test tools/email-delivery.test.mjs tools/email-delivery-control.test.mjs",
    "test:analytics": "node --test tools/analytics-digest.test.mjs",
    "test:telegram": "node --test tools/telegram-history.test.mjs",
    "test:rkn": "node --test tools/rkn-public-surface.test.mjs",
    "test:deploy": "node --test tools/deploy-pipeline.test.mjs",
    "check:shell": "npm run test:shell && node tools/sync-site-shell.mjs --check",
    "check:data": "npm run test:data && node tools/sync-product-data.mjs --check && node tools/verify-product-data.mjs",
    "check:runtime": "npm run test:runtime && node tools/sync-runtime-assets.mjs --check",
    "check:leads": "npm run test:leads",
    "check:backend": "npm run test:backend",
    "check:email": "npm run test:email",
    "check:analytics": "npm run test:analytics",
    "check:telegram": "npm run test:telegram",
    "check:rkn": "npm run test:rkn",
    "check:deploy": "npm run test:deploy",
    "check:syntax": "node tools/check-javascript-syntax.mjs",
    "check:php": "node tools/check-php.mjs",
    "check:artifact": "node tools/verify-public-site.mjs",
    "verify:release": "node tools/verify-current-release.mjs",
    "check:seo": "node tools/run-public-seo-checks.mjs",
    "check": "npm run check:syntax && npm run check:php && npm run check:shell && npm run check:data && npm run check:runtime && npm run check:leads && npm run check:backend && npm run check:email && npm run check:analytics && npm run check:telegram && npm run check:rkn && npm run check:deploy && npm run build && npm run check:artifact && npm run check:seo",
    "verify": "npm run check"
  }
}
