# EGOE — egoe-life.ru (canonical: www + https)
# Работает, если хостинг обслуживает Apache (в т.ч. Apache за nginx в ISPmanager).
# На чистом nginx этот файл игнорируется — тогда включите те же редиректы тумблерами в панели.

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Старый раздел производства объединён со страницей /about/.
  RewriteRule ^proizvodstvo(?:/index\.html)?/?$ https://www.egoe-life.ru/about/ [R=301,L,NE,NC]

  # Дубль товара: основная карточка находится в разделе павильонов и навесов.
  RewriteRule ^maf/skamejki/skameyka-s-navesom-filigran-volna(?:/index\.html)?/?$ https://www.egoe-life.ru/maf/pavilony-i-navesy/skameyka-s-navesom-filigran-volna/ [R=301,L,NE,NC]

  # Явный /index.html -> красивый URL с завершающим слешем.
  # THE_REQUEST не даёт зациклить внутреннюю подстановку DirectoryIndex.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ https://www.egoe-life.ru/$1 [R=301,L,NE]

  # Любой неканонический host -> HTTPS + www за один переход.
  RewriteCond %{HTTP_HOST} !^www\.egoe-life\.ru$ [NC]
  RewriteRule ^ https://www.egoe-life.ru%{REQUEST_URI} [R=301,L,NE]

  # HTTP -> HTTPS. На REG.RU TLS завершается на nginx, поэтому Apache получает
  # HTTPS=off и доверенный прокси передаёт исходную схему в X-Forwarded-Proto.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://www.egoe-life.ru%{REQUEST_URI} [R=301,L,NE]

  # Два same-origin URL (статус и приём) ведут к единственной PHP-точке.
  # Общая библиотека и CLI входят в immutable release, но не доступны по HTTP.
  RewriteRule ^api/leads/(?:cli|lib)(?:/|$) - [R=404,L,NC]
  RewriteCond %{THE_REQUEST} \s/+api/leads/index\.php(?:[/?\s]) [NC]
  RewriteRule ^api/leads/index\.php(?:/.*)?$ - [R=404,L,NC]
  RewriteRule ^api/leads/index/?$ - [R=404,L,NC]
  RewriteRule ^api/leads/status/?$ api/leads/index.php [END]
  RewriteRule ^api/leads/?$ api/leads/index.php [END]
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# Кэш статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html             "access plus 1 hour"
</IfModule>

# Кодировка
AddDefaultCharset UTF-8
